--- !u!114 &920000003
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 920000001}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7c0201c4934f42c7949161c9a4b63f0e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Terror.Inventario
  catalogo:
  - id: foto_campo
    nombre: "Foto de la casa del campo"
    icono: {fileID: 21300000, guid: e223ab5de9bf40aebb6b3136ea1c5a67, type: 3}
    ilustracion: {fileID: 0}
    textos:
    - "Una foto vieja de una casa en el campo."
    - "Atr\xE1s, con la letra de la abuelita: \xABVolvimos al campo, 1987\xBB."
    - "Tiene el tama\xF1o justo de un portarretrato..."
    dibujoPorTexto:
    - {fileID: 21300000, guid: e223ab5de9bf40aebb6b3136ea1c5a67, type: 3}
    - {fileID: 21300000, guid: 4695537b9772417284dcd48e88a789a1, type: 3}
    - {fileID: 21300000, guid: e223ab5de9bf40aebb6b3136ea1c5a67, type: 3}
  - id: agenda
    nombre: "Agenda de la abuelita"
    icono: {fileID: 21300000, guid: dbeb2dbd1a5d4eda9aa2048454c79d1c, type: 3}
    ilustracion: {fileID: 0}
    textos:
    - "La agenda de costura de la abuelita: pedidos, medidas, nombres de las vecinas..."
    - "\xABDo\xF1a Rosa: vestido azul para el s\xE1bado. Do\xF1a Carmen: basta del pantal\xF3n.\xBB"
    - "En la \xFAltima hoja, subrayado: \xABClave del joyero: el a\xF1o en que volvimos al campo\xBB."
    dibujoPorTexto: []
  - id: llave_pequena
    nombre: "Llave peque\xF1a"
    icono: {fileID: 21300000, guid: f32e683ecda7481694fe1c45a873635e, type: 3}
    ilustracion: {fileID: 0}
    textos:
    - "Una llavecita dorada. Estaba en el joyero de la abuelita."
    - "\xBFQu\xE9 se abrir\xE1 con algo tan chiquito?"
    dibujoPorTexto: []
  - id: llave_armario
    nombre: "Llave del armario"
    icono: {fileID: 21300000, guid: 3776fd09c24e4050af1fef5feec7d6e8, type: 3}
    ilustracion: {fileID: 0}
    textos:
    - "Estaba en la lata de galletas, entre hilos y agujas."
    - "Tiene una cinta que dice \xABarmario\xBB."
    dibujoPorTexto: []
  - id: llave_puerta
    nombre: "Llave de la puerta"
    icono: {fileID: 21300000, guid: e3f2fd540fa2460bb895cb007707d04e, type: 3}
    ilustracion: {fileID: 0}
    textos:
    - "\xA1La llave del cuarto! Con esto puedo salir."
    dibujoPorTexto: []
