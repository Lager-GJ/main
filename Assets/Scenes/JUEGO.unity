  m_Script: {fileID: 11500000, guid: a07e7c8a58f94d6f8b067d47d6f89844, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Terror.UI.InicioCuarto
  contenedorUI: {fileID: 744201470}
  insertarDespuesDe: {fileID: 14855983}
  luzPuerta: {fileID: 730000013}
  fosforosRecogibles: {fileID: 150038088}
  fuente: {fileID: 11400000, guid: 21c911762b0085843a25967b0b48a1c0, type: 2}
  empezarConCajonAbierto: 1
  ocultarHastaPrimerFosforo: []
  fondoCajon: {fileID: 21300000, guid: a55028f1133847f5af13963613569f6c, type: 3}
  tamanoCajon: {x: 1260, y: 720}
  posicionCajon: {x: 0, y: -60}
  brilloFosforo: {fileID: 21300000, guid: 63da3c1723d847ac8667ced6994bc71a, type: 3}
  nombreFosforos: "Fuego maldito"
  spriteFosforos: {fileID: 1548913901372772283, guid: 44aff36dfd0a78941a569d2a0c92ec44, type: 3}
  posicionFosforos: {x: 18, y: 0}
  tamanoFosforos: {x: 300, y: 300}
  rotacionFosforos: 0
  nombreNota: "Una nota"
  spriteNota: {fileID: 21300000, guid: fd4756b0c19549c1a0228f39c4bb49ce, type: 3}
  posicionNota: {x: 18, y: -9}
  tamanoNota: {x: 270, y: 198}
  rotacionNota: 0
  textosNota:
  - "Es la letra de la abuelita... (pr\xF3ximamente)"
  alLeerNota:
    m_PersistentCalls:
      m_Calls: []
  marcoTarjeta: {fileID: 0}
  spriteSiguiente: {fileID: -1419229221178902814, guid: 37f5c8da8677bfc4a86852a0ecea89a3, type: 3}
  cajonConMarco: 1
  tamanoTarjeta: {x: 1000, y: 510}
  posicionTarjeta: {x: 0, y: 70}
  colorTarjetaProvisoria: {r: 0.5, g: 0.5, b: 0.5, a: 1}
  elementos:
  - nombre: "Rosario"
    sprite: {fileID: 21300000, guid: 5edf584097024bc6bf9ad859847cde77, type: 3}
    posicion: {x: -261, y: 54}
    tamano: {x: 378, y: 306}
    rotacion: 0
    textos:
    - "El rosario de la abuelita. Lo reza todas las noches..."
    - "\xBFPor qu\xE9 no se lo llev\xF3? Nunca sale sin \xE9l."
    sonido: {fileID: 0}
  - nombre: "Hilo y aguja"
    sprite: {fileID: 21300000, guid: 66f8461e65404635b90b28e6ddd74d49, type: 3}
    posicion: {x: 351, y: 117}
    tamano: {x: 234, y: 216}
    rotacion: 0
    textos:
    - "Hilo negro y una aguja. Con esto me remienda los pantalones."
    - "Mejor no lo toco... me voy a pinchar."
    sonido: {fileID: 0}
  - nombre: "Cabo de vela"
    sprite: {fileID: 21300000, guid: 1a5c723d9ba44dd1a8482b7c4b176410, type: 3}
    posicion: {x: 288, y: -68}
    tamano: {x: 252, y: 153}
    rotacion: 0
    textos:
    - "Una vela... toda consumida. No sirve ni para un ratito."
    - "Con raz\xF3n la abuelita tuvo que salir a comprar velitas."
    sonido: {fileID: 0}
  - nombre: "Foto vieja"
    sprite: {fileID: 0}
    posicion: {x: -390, y: -80}
    tamano: {x: 170, y: 125}
    rotacion: -7
    ilustracion: {fileID: 0}
    textos:
    - "Una foto vieja de la abuelita, cuando era joven."
    - "A su lado hab\xEDa alguien m\xE1s... pero lo recortaron con tijera."
    sonido: {fileID: 0}
  - nombre: "Estampita"
    sprite: {fileID: 0}
    posicion: {x: -185, y: -95}
    tamano: {x: 90, y: 130}
    rotacion: 8
    ilustracion: {fileID: 0}
    textos:
    - "Una estampita de un santo, gastada de tanto rezarle."
    - "Atr\xE1s, con l\xE1piz: \xABQue nunca se te apague la luz, mijito\xBB."
    sonido: {fileID: 0}
  textoAlAbrir: "Aqu\xED guarda la abuelita sus cosas... y los f\xF3sforos."
  textoTomarFosforos: "\xABFuego maldito\xBB... qu\xE9 nombre tan raro para unos f\xF3sforos."
  textoPortazo: "\xA1PUM! La puerta se cerr\xF3 sola..."
  textoSinLuz: "Est\xE1 muy oscuro. No veo nada."
  textoNotaAparece: "Debajo de los f\xF3sforos hab\xEDa una nota..."
  textoAyudaCerrar: "Esc o clic afuera para volver al cuarto"
  sonidoAbrirCajon: {fileID: 8300000, guid: 169924c01ee115f4c941c32b63a7061e, type: 3}
  sonidoTomarFosforos: {fileID: 8300000, guid: 007c1f682165a9d478358bbe50642f9b, type: 3}
  sonidoPortazo: {fileID: 8300000, guid: b970e762142e5a448992411da8d7a471, type: 3}
  sonidoRevelarNota: {fileID: 8300000, guid: 30775c42267099140a77ba3293055ea7, type: 3}
  sonidoObjeto: {fileID: 8300000, guid: 87277cd809e16d24a860a7b20d686952, type: 3}
  tintePuerta: {r: 0.78, g: 0.82, b: 0.92, a: 1}
  tinteOscuro: {r: 0.17, g: 0.17, b: 0.19, a: 1}
  tinteFosforo: {r: 1, g: 0.93, b: 0.82, a: 1}
  fondoConPuertaAbierta: 0.55
  fondoAOscuras: 0.9
  esperaAntesDelPortazo: 0.7
  duracionApagarLuz: 0.25
  sacudidaPortazo: 22
